@using Domain.Entities
@model Dish

<div class="card h-100 d-flex flex-column">

    @if (!string.IsNullOrEmpty(Model.Image))
    {
        var imageUrl = Model.Image;
        // Если это полный URL с localhost:9999, конвертируем в относительный путь
        if (imageUrl.StartsWith("http://localhost:9999/", StringComparison.OrdinalIgnoreCase) || 
            imageUrl.StartsWith("https://localhost:9999/", StringComparison.OrdinalIgnoreCase))
        {
            // Извлекаем относительный путь из полного URL
            var uri = new Uri(imageUrl);
            imageUrl = uri.PathAndQuery.TrimStart('/');
        }
        
        // Если это относительный путь (не начинается с http), добавляем ~/
        if (!imageUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) && 
            !imageUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            imageUrl = "~/" + imageUrl.TrimStart('/');
        }
        
        <img src="@Url.Content(imageUrl)"
             class="card-img-top dish-image-catalog"
             alt="@Model.Name" />
    }
    else
    {
        <div class="dish-image-catalog bg-light d-flex align-items-center justify-content-center">
            <span class="text-muted">Нет изображения</span>
        </div>
    }

    <div class="card-body d-flex flex-column">
        <h5 class="card-title">@Model.Name</h5>
        <p class="card-text">@Model.Description</p>

        <div class="d-flex justify-content-between align-items-center mt-auto mb-3">
            <span>
                @if (Model.Weight.HasValue)
                {
                    <span>Вес: @Model.Weight г.</span>
                }
            </span>

            <strong>@Model.Price.ToString("C")</strong>
        </div>

        <a href="@Url.Action("Add", "Cart", new { id = Model.Id, returnUrl = Context.Request.Path + Context.Request.QueryString })"
           class="btn btn-primary w-100">
            В корзину
        </a>
    </div>

</div>
