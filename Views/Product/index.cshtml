@using Domain.Entities
@using Domain.Models
@model ProductListModel<Dish>

@{
    ViewData["Title"] = "Меню кафе";
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    var selectedCategory = ViewBag.SelectedCategory as string;
    var request = ViewContext.HttpContext.Request;
    var returnUrl = request.Path + request.QueryString.ToUriComponent();
}

<div class="container mt-5">
    <div class="row">

        <!-- Сайдбар с категориями -->
        <div class="col-md-3">
            <h5>Категории</h5>
            <div class="list-group">

                <a href="@Url.Action("Index", "Product")"
                   class="list-group-item list-group-item-action @(selectedCategory == null ? "active" : "")">
                    Все блюда
                </a>

                @foreach (var cat in categories)
                {
                    <a href="@Url.Action("Index", "Product", new { category = cat.NormalizedName })"
                       class="list-group-item list-group-item-action @(selectedCategory == cat.NormalizedName ? "active" : "")">
                        @cat.Name
                    </a>
                }
            </div>
        </div>

        <!-- Контент (список блюд) -->
        <div class="col-md-9">

            <h3>
                @(selectedCategory != null
                    ? $"Категория: {categories.FirstOrDefault(c => c.NormalizedName == selectedCategory)?.Name}"
                    : "Все блюда")
            </h3>

            <div class="row">
                @foreach (var item in Model.Items)
                {
                    <div class="col-md-6 col-lg-4 mb-4">
                        <partial name="_ProductItemPartial" model="@item" />
                    </div>
                }
            </div>

            <!-- Пагинация -->
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">

                    @{
                        int prev = Model.CurrentPage == 1 ? 1 : Model.CurrentPage - 1;
                        int next = Model.CurrentPage == Model.TotalPages ? Model.TotalPages : Model.CurrentPage + 1;
                    }

                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           href="@Url.Action("Index", "Product", new { category = selectedCategory, page = prev })">
                            Previous
                        </a>
                    </li>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               href="@Url.Action("Index", "Product", new { category = selectedCategory, page = i })">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           href="@Url.Action("Index", "Product", new { category = selectedCategory, page = next })">
                            Next
                        </a>
                    </li>

                </ul>
            </nav>

        </div>
    </div>
</div>
