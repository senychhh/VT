@page
@model Kolbasin_lab1.Areas.Admin.Pages.Dishes.DeletedModel

@{
    ViewData["Title"] = "История удаленных блюд";
}

<h1 class="mb-3">История удаленных блюд</h1>

<p>
    <a asp-page="Index" class="btn btn-secondary">
        <i class="fa-solid fa-arrow-left"></i> Назад к списку
    </a>
</p>

@if (Model.DeletedDishes.Count == 0)
{
    <div class="alert alert-info">
        Нет удаленных блюд.
    </div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.DeletedDishes[0].Name)</th>
                <th>@Html.DisplayNameFor(model => model.DeletedDishes[0].Description)</th>
                <th>@Html.DisplayNameFor(model => model.DeletedDishes[0].Price)</th>
                <th>@Html.DisplayNameFor(model => model.DeletedDishes[0].Weight)</th>
                <th>@Html.DisplayNameFor(model => model.DeletedDishes[0].Image)</th>
                <th>@Html.DisplayNameFor(model => model.DeletedDishes[0].Category)</th>
                <th>Дата удаления</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.DeletedDishes)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@item.Price</td>
                    <td>@item.Weight</td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.Image))
                        {
                            var imageUrl = item.Image;
                            if (!imageUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) && 
                                !imageUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
                            {
                                imageUrl = "~/" + imageUrl.TrimStart('/');
                            }
                            <img src="@Url.Content(imageUrl)"
                                 alt="@item.Name"
                                 class="dish-image-admin" />
                        }
                        else
                        {
                            <div class="dish-image-admin bg-light d-flex align-items-center justify-content-center">
                                <span class="text-muted small">Нет изображения</span>
                            </div>
                        }
                    </td>
                    <td>@item.Category?.Name</td>
                    <td>@(item.DeletedAt?.ToString("dd.MM.yyyy HH:mm") ?? "Не указано")</td>
                    <td>
                        <form method="post" asp-page-handler="Restore" asp-route-id="@item.Id" style="display: inline;">
                            <button type="submit" class="btn btn-success btn-sm" 
                                    onclick="return confirm('Восстановить это блюдо?');">
                                <i class="fa-solid fa-rotate-left"></i> Восстановить
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Пагинация -->
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            @{
                int prev = Model.CurrentPage == 1 ? 1 : Model.CurrentPage - 1;
                int next = Model.CurrentPage == Model.TotalPages ? Model.TotalPages : Model.CurrentPage + 1;
            }

            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-page="./Deleted" asp-route-pageNo="@prev">
                    &laquo;
                </a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-page="./Deleted" asp-route-pageNo="@i">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-page="./Deleted" asp-route-pageNo="@next">
                    &raquo;
                </a>
            </li>
        </ul>
    </nav>
}

