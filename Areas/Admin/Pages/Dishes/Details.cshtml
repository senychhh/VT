@page
@model Kolbasin_lab1.Areas.Admin.Pages.Dishes.DetailsModel

@{
    ViewData["Title"] = "Детали блюда";
}

<h1>Детали блюда</h1>

<div>
    <h4>@Model.Dish.Name</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Dish.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Dish.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Dish.Description)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Dish.Description)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Dish.Price)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Dish.Price) руб.
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Dish.Weight)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Dish.Weight) г
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Dish.Image)
        </dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.Dish.Image))
            {
                var imageUrl = Model.Dish.Image;
                // Если это относительный путь, добавляем ~/
                if (!imageUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) && 
                    !imageUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
                {
                    imageUrl = "~/" + imageUrl.TrimStart('/');
                }
                <img src="@Url.Content(imageUrl)" alt="@Model.Dish.Name" class="img-thumbnail" style="max-width: 300px; max-height: 300px;" />
            }
            else
            {
                <span class="text-muted">Изображение не загружено</span>
            }
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Dish.Category)
        </dt>
        <dd class="col-sm-10">
            @(Model.Dish.Category?.Name ?? "Не указана")
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Dish.Id" class="btn btn-success">
        <i class="fa-solid fa-pen-to-square"></i> Редактировать
    </a>
    <a asp-page="./Index" class="btn btn-secondary ms-2">
        <i class="fa-solid fa-arrow-left"></i> Назад к списку
    </a>
</div>
