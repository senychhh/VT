@page
@model Kolbasin_lab1.Areas.Admin.Pages.Dishes.IndexModel

@{
    ViewData["Title"] = "Admin Dishes";

}

<h1 class="mb-3">Dishes admin</h1>
<p>
   <a asp-page="Create" class="btn btn-primary">
        <i class="fa-solid fa-plus"></i> Create new</a>
   <a asp-page="Deleted" class="btn btn-outline-secondary ms-2">
        <i class="fa-solid fa-trash-can"></i> История удаленных</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Dishes[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Dishes[0].Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Dishes[0].Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Dishes[0].Weight)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Dishes[0].Image)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Dishes[0].Category)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Dishes)
        {
            <tr>
                <td>@item.Name
                </td>
                <td>
                    @item.Description
                </td>
                <td>
                    @item.Price
                </td>
                <td>
                    @item.Weight
                </td>
                <td>
                   @if (!string.IsNullOrEmpty(item.Image))
                   {
                       var imageUrl = item.Image;
                       // Если это относительный путь, добавляем ~/
                       if (!imageUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) && 
                           !imageUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
                       {
                           imageUrl = "~/" + imageUrl.TrimStart('/');
                       }
                       <img src="@Url.Content(imageUrl)"
                            alt="@item.Name"
                            class="dish-image-admin" />
                   }
                   else
                   {
                       <div class="dish-image-admin bg-light d-flex align-items-center justify-content-center">
                           <span class="text-muted small">Нет изображения</span>
                       </div>
                   }
                </td>
                <td>
                    @item.Category?.Name
                </td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-success me-1">
                        <i class="fa-solid fa-pen-to-square"></i></a> 
                    <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-primary me-1">
                        <i class="fa-solid fa-info"></i></a> 
                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-danger"><i
                            class="fa-regular fa-trash-can"></i></a>
                </td>
            </tr>
        }

    </tbody>
</table>
<pager admin="true" current-page="@Model.CurrentPage" 
total-pages="@Model.TotalPages">
</pager>