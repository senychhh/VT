@page
@model Kolbasin_lab1.Areas.Admin.Pages.Dishes.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Редактирование</h1>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" asp-validation-summary="All"></div>
}

<div class="row">
    <div class="col-md-6">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Dish.Id" />
            
            <div class="mb-3">
                <label asp-for="Dish.Name" class="form-label">Название</label>
                <input asp-for="Dish.Name" class="form-control" />
                <span asp-validation-for="Dish.Name" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Dish.Description" class="form-label">Описание</label>
                <input asp-for="Dish.Description" class="form-control" />
                <span asp-validation-for="Dish.Description" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Dish.Price" class="form-label">Цена</label>
                <input asp-for="Dish.Price" class="form-control" />
                <span asp-validation-for="Dish.Price" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Dish.Weight" class="form-label">Вес</label>
                <input asp-for="Dish.Weight" class="form-control" />
                <span asp-validation-for="Dish.Weight" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Dish.CategoryId" class="form-label">Категория</label>
                <select asp-for="Dish.CategoryId" class="form-select" asp-items="@(ViewData["CategoryId"] as SelectList)"></select>
                <span asp-validation-for="Dish.CategoryId" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Image" class="form-label">Новое изображение (оставьте пустым, чтобы оставить текущее)</label>
                <input asp-for="Image" class="form-control" type="file" accept="image/*" />
                @if (!string.IsNullOrEmpty(Model.Dish.Image))
                {
                    <div class="mt-2">
                        <small class="text-muted">Текущее изображение:</small><br />
                        <img src="@Model.Dish.Image" alt="@Model.Dish.Name" style="max-width: 200px; max-height: 200px;" />
                    </div>
                }
            </div>
            
            <div class="mb-3">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-save"></i> Сохранить
                </button>
                <a asp-page="./Index" class="btn btn-secondary ms-2">Назад</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

